# ============================================================
# FrotaMaq - Variáveis de ambiente
# ============================================================
#
# COMO CONFIGURAR:
# 1. Copie este arquivo para .env na RAIZ do projeto:
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Mac/Linux)
#
# 2. Acesse https://supabase.com/dashboard e abra seu projeto
#
# 3. Vá em: Project Settings (engrenagem) → API
#
# 4. Preencha abaixo:
#    - VITE_SUPABASE_URL     = Project URL
#    - VITE_SUPABASE_ANON_KEY = anon public (chave pública)
#
# 5. Salve o .env e REINICIE o servidor de desenvolvimento:
#      npm run dev
#
# ============================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: apenas para npm run seed:users (NÃO exponha no frontend)
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Opcional: npm run configure:supabase-auth (Redirect URLs localhost:5173)
# Token em https://supabase.com/dashboard/account/tokens (auth_config_write)
# SUPABASE_ACCESS_TOKEN=seu-personal-access-token

# Opcional: Co-Piloto de IA (Gemini) na dashboard e no detalhe do veículo.
# Sem esta chave, a análise preditiva usa o fallback local (heurística) e a tela não quebra.
# Obtenha em https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=sua-chave-gemini-aqui
