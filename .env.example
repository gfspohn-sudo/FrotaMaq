# ============================================================
# FrotaMaq - Variáveis de ambiente
# ============================================================
#
# COMO CONFIGURAR:
# 1. Copie este arquivo para .env na RAIZ do projeto:
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Mac/Linux)
#
# 2. Acesse https://supabase.com/dashboard e abra seu projeto
#
# 3. Vá em: Project Settings (engrenagem) → API
#
# 4. Preencha abaixo:
#    - VITE_SUPABASE_URL     = Project URL
#    - VITE_SUPABASE_ANON_KEY = anon public (chave pública)
#
# 5. Salve o .env e REINICIE o servidor de desenvolvimento:
#      npm run dev
#
# ============================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: apenas para npm run seed:users (NÃO exponha no frontend)
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
