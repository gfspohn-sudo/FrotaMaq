{
  "theme": "base",
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#dbeafe",
    "primaryTextColor": "#0f172a",
    "primaryBorderColor": "#2563eb",
    "secondaryColor": "#d1fae5",
    "secondaryTextColor": "#064e3b",
    "secondaryBorderColor": "#059669",
    "tertiaryColor": "#f1f5f9",
    "lineColor": "#334155",
    "textColor": "#0f172a",
    "fontFamily": "Inter, Arial, Helvetica, sans-serif",
    "fontSize": "16px",
    "actorBkg": "#0f172a",
    "actorTextColor": "#f8fafc",
    "actorBorder": "#2563eb",
    "actorLineColor": "#334155",
    "signalColor": "#0f172a",
    "signalTextColor": "#0f172a",
    "noteBkgColor": "#ecfdf5",
    "noteTextColor": "#064e3b",
    "noteBorderColor": "#059669",
    "classText": "#0f172a"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "padding": 16,
    "nodeSpacing": 40,
